<Application x:Class="WpfCSharp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#060A14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="CardBrush" Color="#17243D" />
        <SolidColorBrush x:Key="GridBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A7B4CC" />
        <SolidColorBrush x:Key="GreenBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="RedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="YellowBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#F97316" />
    </Application.Resources>
</Application>
