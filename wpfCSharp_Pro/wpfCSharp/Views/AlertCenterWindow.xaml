<Window x:Class="WpfCSharp.Views.AlertCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Module 3 - Alert Center" Height="760" Width="1120" WindowStartupLocation="CenterScreen" Background="#060A14">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F8FAFC"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2B45"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="#F8FAFC"/></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#0F172A" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <UniformGrid Columns="5">
                <StackPanel><TextBlock Text="BUY CE Score" Foreground="#A7B4CC"/><TextBlock Text="{Binding BullishScore}" FontSize="26" FontWeight="Bold" Foreground="#22C55E"/></StackPanel>
                <StackPanel><TextBlock Text="BUY PE Score" Foreground="#A7B4CC"/><TextBlock Text="{Binding BearishScore}" FontSize="26" FontWeight="Bold" Foreground="#EF4444"/></StackPanel>
                <StackPanel><TextBlock Text="Support" Foreground="#A7B4CC"/><TextBlock Text="{Binding SupportStrike, StringFormat=N0}" FontSize="22" Foreground="#22C55E"/></StackPanel>
                <StackPanel><TextBlock Text="Resistance" Foreground="#A7B4CC"/><TextBlock Text="{Binding ResistanceStrike, StringFormat=N0}" FontSize="22" Foreground="#EF4444"/></StackPanel>
                <StackPanel><TextBlock Text="Status" Foreground="#A7B4CC"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel>
            </UniformGrid>
        </Border>
        <TabControl Grid.Row="1" Background="#0F172A">
            <TabItem Header="Live Alerts">
                <DataGrid ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0B1220" RowBackground="#0B1220" AlternatingRowBackground="#101A2D">
                    <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="90"/><DataGridTemplateColumn Header="Severity" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Severity}" Foreground="{Binding Brush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="1m"/><TabItem Header="3m"/><TabItem Header="5m"/><TabItem Header="10m"/><TabItem Header="15m"/><TabItem Header="30m"/><TabItem Header="60m"/><TabItem Header="120m"/><TabItem Header="180m"/><TabItem Header="240m"/>
        </TabControl>
    </Grid>
</Window>
