<Window x:Class="WpfCSharp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wpfCSharp Pro - FYERS Trading Terminal" Height="900" Width="1650" MinHeight="780" MinWidth="1300"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style x:Key="Btn" TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="TfItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="#17243D"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#EEF4FF"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2B45"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#26344D"/><Setter Property="Padding" Value="6,4"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="3.3*"/><ColumnDefinition Width="2.2*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="wpfCSharp Pro" FontSize="16" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="FYERS TRADING TERMINAL" FontSize="30" FontWeight="Bold"/><TextBlock Text="Module 1 Chart | Module 2 Option Chain ATM +/- 10 | Module 3 Alert Center" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Symbol" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="140" ItemsSource="{Binding Symbols}" SelectedItem="{Binding SelectedSymbol}"/>
                    <TextBlock Text="TF" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <ListBox Width="360" Height="34" ItemsSource="{Binding Timeframes}" SelectedItem="{Binding SelectedTimeframe}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource TfItem}">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <CheckBox Content="Paper" IsChecked="{Binding PaperTradingMode}" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox Content="Live FYERS" IsChecked="{Binding UseLiveFyers}" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox Content="Dark Chart" IsChecked="{Binding IsDarkChartMode}" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBox Width="130" Text="{Binding AppId}" ToolTip="FYERS AppId" Margin="8,0,0,0"/>
                    <TextBox Width="260" Text="{Binding AccessToken}" ToolTip="FYERS Access Token" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource Btn}" Content="Apply" Command="{Binding ApplyFyersCommand}" Background="{StaticResource PurpleBrush}"/>
                </WrapPanel>
                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn}" Content="Start" Command="{Binding StartCommand}" Background="{StaticResource GreenBrush}"/>
                    <Button Style="{StaticResource Btn}" Content="Stop" Command="{Binding StopCommand}" Background="{StaticResource RedBrush}"/>
                    <Button Style="{StaticResource Btn}" Content="Option Chain" Command="{Binding OpenOptionChainCommand}" Background="#2563EB"/>
                    <Button Style="{StaticResource Btn}" Content="Alert Center" Command="{Binding OpenAlertsCommand}" Background="{StaticResource OrangeBrush}"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3.3*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
                    <UniformGrid Columns="8" Margin="0,0,0,10">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="Spot" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SpotPrice, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="ATM" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding AtmStrike, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YellowBrush}"/></StackPanel></Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="VWAP" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Vwap, StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="EMA20/50" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Ema20, StringFormat=N0}" FontSize="16"/><TextBlock Text="{Binding Ema50, StringFormat=N0}" FontSize="16"/></StackPanel></Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="RSI" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Rsi}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="ATR/ADX" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Atr}"/><TextBlock Text="{Binding Adx}"/></StackPanel></Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="Support" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SupportStrike, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/></StackPanel></Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="4"><StackPanel><TextBlock Text="Resistance" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ResistanceStrike, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Grid.Row="1" CornerRadius="14" Background="{Binding ChartBackgroundBrush}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="360"/>
                                <RowDefinition Height="88"/>
                                <RowDefinition Height="72"/>
                                <RowDefinition Height="72"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Candlestick Chart with VWAP + EMA20 + EMA50" Foreground="{Binding ChartTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="SemiBold"/>
                            <Canvas Grid.Row="0" Height="350" Width="1040" Margin="0,22,0,0" Background="{Binding ChartBackgroundBrush}">
                                <Line X1="0" Y1="82" X2="1040" Y2="82" Stroke="{Binding ChartGridBrush}" StrokeThickness="1" Opacity="0.55"/>
                                <Line X1="0" Y1="165" X2="1040" Y2="165" Stroke="{Binding ChartGridBrush}" StrokeThickness="1" Opacity="0.55"/>
                                <Line X1="0" Y1="248" X2="1040" Y2="248" Stroke="{Binding ChartGridBrush}" StrokeThickness="1" Opacity="0.55"/>
                                <Polyline Points="{Binding Ema20Points}" Stroke="#FBBF24" StrokeThickness="2"/>
                                <Polyline Points="{Binding Ema50Points}" Stroke="#FB923C" StrokeThickness="2"/>
                                <Polyline Points="{Binding VwapPoints}" Stroke="#3B82F6" StrokeThickness="2"/>
                                <ItemsControl ItemsSource="{Binding ChartCandles}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="350" Width="1040"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate><DataTemplate><Canvas Width="13" Height="350"><Rectangle Width="2" Height="{Binding WickHeight}" Fill="{Binding CandleBrush}" Canvas.Left="5.5" Canvas.Top="{Binding WickTop}"/><Rectangle Width="9" Height="{Binding BodyHeight}" Fill="{Binding CandleBrush}" Canvas.Left="2" Canvas.Top="{Binding BodyTop}" RadiusX="1" RadiusY="1"/></Canvas></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Canvas.Left="12" Canvas.Top="318">
                                    <TextBlock Text="EMA20" Foreground="#FBBF24" FontWeight="Bold" Margin="0,0,14,0"/>
                                    <TextBlock Text="EMA50" Foreground="#FB923C" FontWeight="Bold" Margin="0,0,14,0"/>
                                    <TextBlock Text="VWAP" Foreground="#3B82F6" FontWeight="Bold"/>
                                </StackPanel>
                            </Canvas>
                            <Border Grid.Row="1" Background="{Binding ChartBackgroundBrush}" CornerRadius="10" Padding="6" Margin="0,8,0,0" BorderBrush="{Binding ChartGridBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="Volume" Foreground="{Binding ChartTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <ItemsControl ItemsSource="{Binding ChartCandles}" Margin="0,14,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="74" Width="1040"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/></Style></ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate><DataTemplate><Canvas Width="13" Height="74"><Rectangle Width="8" Height="{Binding VolumeHeight}" Fill="{Binding CandleBrush}" Opacity="0.70" Canvas.Left="2" Canvas.Top="{Binding VolumeTop}"/></Canvas></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Background="{Binding ChartBackgroundBrush}" CornerRadius="10" Padding="6" Margin="0,8,0,0" BorderBrush="{Binding ChartGridBrush}" BorderThickness="1">
                                <Canvas Height="65" Width="1040"><TextBlock Text="RSI" Foreground="{Binding ChartTextBrush}" Canvas.Left="0" Canvas.Top="0"/><Line X1="0" Y1="20" X2="1040" Y2="20" Stroke="#EF4444" StrokeThickness="1" Opacity="0.45"/><Line X1="0" Y1="45" X2="1040" Y2="45" Stroke="#22C55E" StrokeThickness="1" Opacity="0.45"/><Polyline Points="{Binding RsiPoints}" Stroke="#A855F7" StrokeThickness="2"/></Canvas>
                            </Border>
                            <Border Grid.Row="3" Background="{Binding ChartBackgroundBrush}" CornerRadius="10" Padding="6" Margin="0,8,0,0" BorderBrush="{Binding ChartGridBrush}" BorderThickness="1">
                                <Canvas Height="65" Width="1040"><TextBlock Text="MACD" Foreground="{Binding ChartTextBrush}" Canvas.Left="0" Canvas.Top="0"/><Line X1="0" Y1="34" X2="1040" Y2="34" Stroke="{Binding ChartGridBrush}" StrokeThickness="1" Opacity="0.7"/><Polyline Points="{Binding MacdPoints}" Stroke="#22C55E" StrokeThickness="2"/><Polyline Points="{Binding MacdSignalPoints}" Stroke="#EF4444" StrokeThickness="2"/></Canvas>
                            </Border>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0B1220" RowBackground="#0B1220" AlternatingRowBackground="#101A2D" Margin="0,10,0,0">
                        <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="90"/><DataGridTemplateColumn Header="Severity" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Severity}" Foreground="{Binding Brush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="16">
                <StackPanel>
                    <TextBlock Text="SIGNAL ENGINE" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="BUY CE SCORE" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/><TextBlock Text="{Binding BullishScore}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                    <ProgressBar Maximum="100" Value="{Binding BullishScore}" Height="18"/>
                    <TextBlock Text="BUY PE SCORE" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,0"/><TextBlock Text="{Binding BearishScore}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                    <ProgressBar Maximum="100" Value="{Binding BearishScore}" Height="18"/>
                    <Separator Margin="0,20,0,20"/>
                    <TextBlock Text="PCR" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Pcr, StringFormat=N2}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="CE Volume / PE Volume" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/><TextBlock Text="{Binding TotalCeVolume, StringFormat=N0}" Foreground="{StaticResource GreenBrush}"/><TextBlock Text="{Binding TotalPeVolume, StringFormat=N0}" Foreground="{StaticResource RedBrush}"/>
                    <TextBlock Text="Status" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource Btn}" Content="BUY CE" Command="{Binding BuyCeCommand}" Background="{StaticResource GreenBrush}" Margin="0,20,0,0"/>
                    <Button Style="{StaticResource Btn}" Content="BUY PE" Command="{Binding BuyPeCommand}" Background="{StaticResource RedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14" Margin="0,12,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Module 2 quick summary" FontSize="19" FontWeight="Bold"/><TextBlock Text="Use Option Chain button for professional ATM +/- 10 CE/PE side-by-side screen with LTP change, OI change, IV, Greeks, Volume %, Writing/Unwinding." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="Trade / Alert Log" FontSize="19" FontWeight="Bold"/><ListBox ItemsSource="{Binding TradeLog}" Background="#0B1220" Foreground="#E5E7EB" BorderThickness="0" Height="125"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
