<Window x:Class="WpfCSharp.Views.OptionChainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Module 2 - FYERS Style Option Chain ATM +/- 10" Height="820" Width="1550" WindowStartupLocation="CenterScreen" Background="#060A14">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2B45"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="7"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Background" Value="{Binding RowBrush}"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Padding" Value="5"/><Setter Property="BorderBrush" Value="#26344D"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#0F172A" CornerRadius="16" Padding="16" Margin="0,0,0,12">
            <UniformGrid Columns="8">
                <StackPanel><TextBlock Text="Spot" Foreground="#A7B4CC"/><TextBlock Text="{Binding SpotPrice, StringFormat=N2}" FontSize="22" FontWeight="Bold"/></StackPanel>
                <StackPanel><TextBlock Text="ATM" Foreground="#A7B4CC"/><TextBlock Text="{Binding AtmStrike, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="#FBBF24"/></StackPanel>
                <StackPanel><TextBlock Text="Support" Foreground="#A7B4CC"/><TextBlock Text="{Binding SupportStrike, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="#22C55E"/></StackPanel>
                <StackPanel><TextBlock Text="Resistance" Foreground="#A7B4CC"/><TextBlock Text="{Binding ResistanceStrike, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="#EF4444"/></StackPanel>
                <StackPanel><TextBlock Text="PCR" Foreground="#A7B4CC"/><TextBlock Text="{Binding Pcr, StringFormat=N2}" FontSize="22" FontWeight="Bold"/></StackPanel>
                <StackPanel><TextBlock Text="CE Vol" Foreground="#A7B4CC"/><TextBlock Text="{Binding TotalCeVolume, StringFormat=N0}" FontSize="18" Foreground="#22C55E"/></StackPanel>
                <StackPanel><TextBlock Text="PE Vol" Foreground="#A7B4CC"/><TextBlock Text="{Binding TotalPeVolume, StringFormat=N0}" FontSize="18" Foreground="#EF4444"/></StackPanel>
            </UniformGrid>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding OptionChain}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#0B1220" RowBackground="#0B1220" AlternatingRowBackground="#101A2D" RowHeight="34" GridLinesVisibility="All">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{Binding RowBrush}"/><Setter Property="Foreground" Value="#F8FAFC"/></Style></DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="CE Analysis" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding CE.AnalysisBrush}" CornerRadius="6" Padding="4"><TextBlock Text="{Binding CE.Analysis}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="CE OI" Binding="{Binding CE.OpenInterest, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="CE OI Chg" Binding="{Binding CE.OiChange, StringFormat=N0}" Width="95"/>
                <DataGridTextColumn Header="CE OI %" Binding="{Binding CE.OiChangePercentText}" Width="70"/>
                <DataGridTextColumn Header="CE Vol" Binding="{Binding CE.Volume, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="CE Vol %" Binding="{Binding CE.VolumeChangePercentText}" Width="75"/>
                <DataGridTextColumn Header="CE IV" Binding="{Binding CE.Iv}" Width="65"/>
                <DataGridTextColumn Header="CE Δ" Binding="{Binding CE.Delta}" Width="55"/>
                <DataGridTextColumn Header="CE Γ" Binding="{Binding CE.Gamma}" Width="55"/>
                <DataGridTextColumn Header="CE θ" Binding="{Binding CE.Theta}" Width="60"/>
                <DataGridTextColumn Header="CE Vega" Binding="{Binding CE.Vega}" Width="65"/>
                <DataGridTemplateColumn Header="CE Chg" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CE.LtpChangeText}" Foreground="{Binding CE.LtpBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CE %" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CE.LtpChangePercentText}" Foreground="{Binding CE.LtpBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CE LTP" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CE.Ltp}" Foreground="{Binding CE.LtpBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="STRIKE" Binding="{Binding StrikeTag}" Width="105"/>
                <DataGridTemplateColumn Header="PE LTP" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PE.Ltp}" Foreground="{Binding PE.LtpBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="PE %" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PE.LtpChangePercentText}" Foreground="{Binding PE.LtpBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="PE Chg" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PE.LtpChangeText}" Foreground="{Binding PE.LtpBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="PE Vega" Binding="{Binding PE.Vega}" Width="65"/>
                <DataGridTextColumn Header="PE θ" Binding="{Binding PE.Theta}" Width="60"/>
                <DataGridTextColumn Header="PE Γ" Binding="{Binding PE.Gamma}" Width="55"/>
                <DataGridTextColumn Header="PE Δ" Binding="{Binding PE.Delta}" Width="55"/>
                <DataGridTextColumn Header="PE IV" Binding="{Binding PE.Iv}" Width="65"/>
                <DataGridTextColumn Header="PE Vol %" Binding="{Binding PE.VolumeChangePercentText}" Width="75"/>
                <DataGridTextColumn Header="PE Vol" Binding="{Binding PE.Volume, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="PE OI %" Binding="{Binding PE.OiChangePercentText}" Width="70"/>
                <DataGridTextColumn Header="PE OI Chg" Binding="{Binding PE.OiChange, StringFormat=N0}" Width="95"/>
                <DataGridTextColumn Header="PE OI" Binding="{Binding PE.OpenInterest, StringFormat=N0}" Width="90"/>
                <DataGridTemplateColumn Header="PE Analysis" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding PE.AnalysisBrush}" CornerRadius="6" Padding="4"><TextBlock Text="{Binding PE.Analysis}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
